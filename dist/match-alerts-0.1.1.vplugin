{"format":"vetro-plugin","version":1,"manifest":{"id":"match-alerts","apiVersion":1,"name":"Match alerts","version":"0.1.1","description":"Follows a football team on ESPN's public scoreboard and shows goals, kick-off, half-time and full-time as TV banners through Notification Center.","author":"mclaudiopt","permissions":[],"main":"index.js","ui":{"label":"Match alerts"}},"files":{"README.md":"# Match alerts\n\nFollows one football team and shows **goals, kick-off, half-time and full-time** as the native Samsung TV banner, on top of whatever is running, through the\n[Notification Center](https://github.com/mclaudiopt/tv-notification-center) Shard (it must be installed, with its companion app). Everything runs on the TV.\n\n## Providers (chosen in the panel)\n\n| Provider | Key | Notes |\n|---|---|---|\n| **ESPN** (public scoreboard) | none | Default. Unofficial, can change without notice. Polls every 20 s while the team's match is live, every 2-3 minutes otherwise. Covers leagues and cups on one feed (tested with Liga Portugal and the Taca de Portugal). |\n| **API-Football** | your own key (free plan: 100 requests/day) | **Experimental, not tested without a key.** Spends few requests: checks the team's next fixture, then polls about every 100 s only while the match is live. |\n\nOther providers (GOAL API, TheSportsDB, football-data.org) are not implemented: add a provider by writing one `match(config, callback)` function in `index.js`.\n\n## What it sends\n\nFor the chosen team: **goal** (banner 30 s by default, up to 60), **goal for the opponent**, **goal disallowed**, **kick-off**, **half-time**, **full time**\n(10 s by default). Each type can be switched off in the panel. A match already in progress when the Shard starts only sets a baseline: no banner for the current score.\n\"Test\" buttons send a sample goal or opponent goal.\n\n## Network and permissions\n\n- Permissions: none (no `exec`).\n- Outgoing: HTTPS GET to `site.api.espn.com` (ESPN) or `v3.football.api-sports.io` (API-Football, with your key), and one local call, `POST /plugins/notification-center/api/notify` on `127.0.0.1:8099`.\n- Stored in `ctx.config`: provider, team, options and, if you set one, the API-Football key (on the TV only; the panel never shows it back).\n- The match log and state are in memory only.\n\n## Install\n\nInstall `match-alerts-0.1.0.vplugin` as a file in Vetro (Developer mode), switch it on, open the **Match alerts** tab, pick the team and press \"Test: goal\".\nNeeds Notification Center 0.2.1 or newer (banner mode).\n","index.js":"'use strict';\n// Match alerts: follows one football team through a score provider of your choice and sends banners through the Notification Center Shard.\n// Providers: ESPN (public scoreboard, no key) and API-Football (needs your own key, 100 requests/day on the free plan, experimental).\n// Plain ES5 (older TVs run Node 4.4). Outgoing: HTTPS GET to the chosen provider, and POST notify to Vetro on 127.0.0.1:8099.\nvar fs = require('fs');\nvar path = require('path');\nvar http = require('http');\nvar https = require('https');\n\nvar NOTIFY = '/plugins/notification-center/api/notify';\nvar MAX_BODY = 4096, MAX_LOG = 30;\nvar E = {\n    ball: String.fromCharCode(0x26BD),\n    net: String.fromCharCode(0xD83E, 0xDD45),\n    no: String.fromCharCode(0xD83D, 0xDEAB),\n    flag: String.fromCharCode(0xD83C, 0xDFC1),\n    whistle: String.fromCharCode(0x23F1, 0xFE0F),\n    pause: String.fromCharCode(0x23F8, 0xFE0F)\n};\nvar DEFAULTS = {\n    provider: 'espn', teamId: '2250', teamName: 'Sporting CP', lang: 'en',\n    on: { goal: true, against: true, start: true, half: true, end: true },\n    goalSeconds: 30, otherSeconds: 10\n};\nvar TXT = {\n    en: { goal: 'GOAL', against: 'Goal for ', varNo: 'Goal disallowed', start: 'Kick-off', half: 'Half-time', end: 'Full time', test: 'Test' },\n    pt: { goal: 'GOLO', against: 'Golo do ', varNo: 'Golo anulado', start: 'Come' + String.fromCharCode(0xE7) + 'ou o jogo', half: 'Intervalo', end: 'Fim do jogo', test: 'Teste' }\n};\n\nmodule.exports = function (ctx) {\n    var timer = null, running = false;\n    var last = {};                       // per match id: { state, desc, our, opp } (memory only)\n    var log = [], teamsCache = {}, status = { at: 0, error: '', line: '', state: '', next: 0 };\n    var af = { nextKick: 0, liveId: '' };   // API-Football bookkeeping, to spend few of the 100 daily requests\n\n    function clamp(v, lo, hi, def) { var n = parseInt(v, 10); if (!(n >= lo)) { return def; } return n > hi ? hi : n; }\n    function clean(s, max) { return String(s == null ? '' : s).replace(/[\\x00-\\x1f]/g, ' ').slice(0, max); }\n    function sendJson(res, code, obj) { res.writeHead(code, { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store' }); res.end(JSON.stringify(obj)); }\n    function readBody(req, cb) {\n        var s = '';\n        req.on('data', function (d) { s += d; if (s.length > MAX_BODY) { req.destroy(); } });\n        req.on('end', function () { cb(s); });\n    }\n    function addLog(kind, text) {\n        log.unshift({ at: Date.now(), kind: kind, text: clean(text, 200) });\n        if (log.length > MAX_LOG) { log.pop(); }\n    }\n\n    // ---- generic HTTPS JSON GET -------------------------------------------------------------------------------------------------\n    function getJson(host, p, headers, cb) {\n        var done = false;\n        function end(err, data) { if (!done) { done = true; cb(err, data); } }\n        var h = { 'Accept-Encoding': 'identity', 'User-Agent': 'vetro-match-alerts' }, k;\n        for (k in headers) { if (headers.hasOwnProperty(k)) { h[k] = headers[k]; } }\n        try {\n            var rq = https.get({ host: host, path: p, headers: h, timeout: 10000 }, function (r) {\n                var s = '';\n                r.setEncoding('utf8');\n                r.on('data', function (d) { s += d; if (s.length > 3000000) { r.destroy(); end('too large'); } });\n                r.on('end', function () {\n                    if (r.statusCode !== 200) { return end('http ' + r.statusCode); }\n                    try { end(null, JSON.parse(s)); } catch (e) { end('bad json'); }\n                });\n            });\n            rq.on('error', function (e) { end(String(e && e.message || e)); });\n            rq.on('timeout', function () { rq.destroy(); end('timeout'); });\n        } catch (e) { end('request failed'); }\n    }\n\n    // ---- providers: each gives the team's match as { id, state: pre|in|post, desc, clock, date, home, away } -----------------------\n    // home / away = { id, name, short, score }\n    function espnMatch(c, cb) {\n        getJson('site.api.espn.com', '/apis/site/v2/sports/soccer/all/scoreboard', {}, function (err, data) {\n            if (err) { return cb(err); }\n            var evs = (data && data.events) || [], i, j, m = null;\n            for (i = 0; i < evs.length && !m; i++) {\n                var cs = (evs[i].competitions && evs[i].competitions[0] && evs[i].competitions[0].competitors) || [], home = null, away = null;\n                for (j = 0; j < cs.length; j++) {\n                    var side = { id: String(cs[j].team.id), name: cs[j].team.displayName, short: cs[j].team.shortDisplayName || cs[j].team.displayName, score: parseInt(cs[j].score, 10) || 0 };\n                    if (cs[j].homeAway === 'home') { home = side; } else { away = side; }\n                }\n                if (home && away && (home.id === c.teamId || away.id === c.teamId)) {\n                    var t = evs[i].status && evs[i].status.type ? evs[i].status.type : {};\n                    m = { id: 'espn-' + evs[i].id, state: t.state || '', desc: t.description || '', clock: evs[i].status.displayClock || '', date: evs[i].date, home: home, away: away };\n                }\n            }\n            cb(null, m, m ? { wait: m.state === 'in' ? 20000 : (m.state === 'pre' && new Date(m.date).getTime() - Date.now() < 900000 ? 30000 : 120000) } : { wait: 180000 });\n        });\n    }\n    function espnTeams(c, cb) {\n        getJson('site.api.espn.com', '/apis/site/v2/sports/soccer/por.1/teams', {}, function (err, d) {\n            if (err) { return cb(err); }\n            var list = [];\n            try { d.sports[0].leagues[0].teams.forEach(function (t) { list.push({ id: String(t.team.id), name: t.team.displayName }); }); } catch (e) { return cb('unexpected answer'); }\n            cb(null, list);\n        });\n    }\n\n    function afGet(c, p, cb) {\n        var key = (ctx.config.get() || {}).keys && (ctx.config.get() || {}).keys.apifootball;\n        if (!key) { return cb('no API-Football key set'); }\n        getJson('v3.football.api-sports.io', p, { 'x-apisports-key': key }, function (err, d) {\n            if (err) { return cb(err); }\n            var e = d && d.errors;\n            if (e && ((Array.isArray(e) && e.length) || (!Array.isArray(e) && Object.keys(e).length))) { return cb('API-Football: ' + clean(JSON.stringify(e), 120)); }\n            cb(null, (d && d.response) || []);\n        });\n    }\n    function afNorm(f) {\n        var s = f.fixture.status.short, st = (s === 'NS' || s === 'TBD' || s === 'PST') ? 'pre' : (s === 'FT' || s === 'AET' || s === 'PEN' || s === 'CANC' || s === 'ABD' || s === 'AWD' || s === 'WO') ? 'post' : 'in';\n        return {\n            id: 'af-' + f.fixture.id, state: st, desc: s === 'HT' ? 'Halftime' : f.fixture.status.long, clock: f.fixture.status.elapsed ? f.fixture.status.elapsed + \"'\" : '', date: f.fixture.date,\n            home: { id: String(f.teams.home.id), name: f.teams.home.name, short: f.teams.home.name, score: f.goals.home || 0 },\n            away: { id: String(f.teams.away.id), name: f.teams.away.name, short: f.teams.away.name, score: f.goals.away || 0 }\n        };\n    }\n    function afMatch(c, cb) {\n        var now = Date.now();\n        if (af.nextKick && now < af.nextKick - 300000) { return cb(null, null, { wait: Math.min(af.nextKick - 300000 - now, 7200000) }); }\n        function schedule() {   // one request: the team's next fixture\n            afGet(c, '/fixtures?team=' + c.teamId + '&next=1', function (err, list) {\n                if (err) { return cb(err); }\n                af.nextKick = list[0] ? new Date(list[0].fixture.date).getTime() : now + 7200000;\n                cb(null, null, { wait: Math.min(Math.max(af.nextKick - 300000 - Date.now(), 60000), 7200000) });\n            });\n        }\n        if (af.liveId) {   // a match we saw live: ask for it directly so the final whistle is not missed\n            return afGet(c, '/fixtures?id=' + af.liveId.replace(/\\D/g, ''), function (err, list) {\n                if (err) { return cb(err); }\n                var m = list[0] ? afNorm(list[0]) : null;\n                if (!m || m.state === 'post') { af.liveId = ''; af.nextKick = 0; }\n                cb(null, m, { wait: 100000 });\n            });\n        }\n        afGet(c, '/fixtures?live=all', function (err, list) {\n            if (err) { return cb(err); }\n            var i, m = null;\n            for (i = 0; i < list.length && !m; i++) {\n                if (String(list[i].teams.home.id) === c.teamId || String(list[i].teams.away.id) === c.teamId) { m = afNorm(list[i]); }\n            }\n            if (m) { af.liveId = m.id; return cb(null, m, { wait: 100000 }); }\n            if (af.nextKick && now >= af.nextKick - 300000 && now < af.nextKick + 1800000) { return cb(null, null, { wait: 100000 }); }   // about to start\n            schedule();\n        });\n    }\n    function afTeams(c, cb) {\n        var d = new Date(), season = d.getMonth() < 6 ? d.getFullYear() - 1 : d.getFullYear();\n        afGet(c, '/teams?league=94&season=' + season, function (err, list) {\n            if (err) { return cb(err); }\n            cb(null, list.map(function (t) { return { id: String(t.team.id), name: t.team.name }; }));\n        });\n    }\n    var PROVIDERS = {\n        espn: { label: 'ESPN (public scoreboard, no key)', needsKey: false, team: { id: '2250', name: 'Sporting CP' }, match: espnMatch, teams: espnTeams },\n        apifootball: { label: 'API-Football (your key, 100 requests/day, experimental)', needsKey: true, team: { id: '228', name: 'Sporting CP' }, match: afMatch, teams: afTeams }\n    };\n\n    // ---- config ----------------------------------------------------------------------------------------------------------------\n    function rawCfg() { return ctx.config.get() || {}; }\n    function cfg() {\n        var c = rawCfg(), d = DEFAULTS, o = {};\n        o.provider = PROVIDERS.hasOwnProperty(c.provider) ? c.provider : d.provider;\n        o.teamId = /^\\d{1,8}$/.test(String(c.teamId)) ? String(c.teamId) : PROVIDERS[o.provider].team.id;\n        o.teamName = clean(c.teamName || PROVIDERS[o.provider].team.name, 40);\n        o.lang = c.lang === 'pt' ? 'pt' : 'en';\n        o.on = {};\n        Object.keys(d.on).forEach(function (k) { o.on[k] = !(c.on && c.on[k] === false); });\n        o.goalSeconds = clamp(c.goalSeconds, 5, 60, d.goalSeconds);\n        o.otherSeconds = clamp(c.otherSeconds, 3, 30, d.otherSeconds);\n        return o;\n    }\n    function publicCfg() {\n        var o = cfg(), keys = rawCfg().keys || {};\n        o.hasKey = !!keys[o.provider];\n        o.providers = Object.keys(PROVIDERS).map(function (k) { return { id: k, label: PROVIDERS[k].label, needsKey: PROVIDERS[k].needsKey }; });\n        return o;\n    }\n\n    // ---- banners ---------------------------------------------------------------------------------------------------------------\n    function banner(title, message, level, icon, seconds) {\n        var body = JSON.stringify({ title: title, message: message, level: level, icon: icon, mode: 'banner', duration: seconds });\n        try {\n            var rq = http.request({\n                host: '127.0.0.1', port: 8099, path: NOTIFY, method: 'POST', timeout: 5000,\n                headers: { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(body) }\n            }, function (r) { r.resume(); });\n            rq.on('error', function () { /* Notification Center not installed or Vetro busy */ });\n            rq.on('timeout', function () { rq.destroy(); });\n            rq.write(body);\n            rq.end();\n        } catch (e) { /* ignore */ }\n    }\n    function lineOf(m) { return m.home.name + ' ' + m.home.score + '-' + m.away.score + ' ' + m.away.name + (m.clock ? ' (' + m.clock + ')' : ''); }\n    function announce(kind, c, m, extra) {\n        var t = TXT[c.lang], line = lineOf(m), seconds = c.otherSeconds, title, level = 'info', icon = '';\n        if (kind === 'goal') { title = E.ball + ' ' + t.goal + ' ' + c.teamName.toUpperCase() + '!'; level = 'ok'; seconds = c.goalSeconds; }\n        else if (kind === 'against') { title = t.against + (extra || '?'); level = 'warn'; icon = E.net; }\n        else if (kind === 'var') { title = t.varNo; level = 'warn'; icon = E.no; }\n        else if (kind === 'start') { title = t.start; icon = E.whistle; }\n        else if (kind === 'half') { title = t.half; icon = E.pause; }\n        else { title = t.end; icon = E.flag; }\n        banner(title, line, level, icon, seconds);   // the goal title already carries the ball, so it has no separate icon\n        addLog(kind, title + ' - ' + line);\n    }\n    function analyse(m, c) {\n        var us = m.home.id === c.teamId ? m.home : m.away, them = us === m.home ? m.away : m.home;\n        var prev = last[m.id];\n        last[m.id] = { state: m.state, desc: m.desc, our: us.score, opp: them.score };\n        status.line = lineOf(m); status.state = m.desc;\n        if (!prev) { return; }                                    // first sight: baseline only, no banner\n        if (us.score > prev.our && c.on.goal) { announce('goal', c, m); }\n        else if (them.score > prev.opp && c.on.against) { announce('against', c, m, them.short); }\n        else if ((us.score < prev.our || them.score < prev.opp) && (c.on.goal || c.on.against)) { announce('var', c, m); }\n        if (prev.state === 'pre' && m.state === 'in' && c.on.start) { announce('start', c, m); }\n        if (/half/i.test(m.desc) && !/half/i.test(prev.desc) && c.on.half) { announce('half', c, m); }\n        if (prev.state === 'in' && m.state === 'post' && c.on.end) { announce('end', c, m); }\n    }\n\n    // ---- polling ---------------------------------------------------------------------------------------------------------------\n    function schedule(ms) {\n        if (!running) { return; }\n        status.next = Date.now() + ms;\n        clearTimeout(timer);\n        timer = setTimeout(poll, ms);\n    }\n    function poll() {\n        if (!running) { return; }\n        var c = cfg();\n        PROVIDERS[c.provider].match(c, function (err, m, hint) {\n            status.at = Date.now();\n            if (err) { status.error = String(err); return schedule(120000); }\n            status.error = '';\n            if (!m) { status.line = ''; status.state = ''; return schedule((hint && hint.wait) || 180000); }\n            analyse(m, c);\n            schedule((hint && hint.wait) || 60000);\n        });\n    }\n\n    function sendFile(res, name, type) {\n        fs.readFile(path.join(__dirname, name), 'utf8', function (err, text) {\n            if (err) { return sendJson(res, 500, { error: name + ' is missing' }); }\n            res.writeHead(200, { 'Content-Type': type, 'Cache-Control': 'no-store' });\n            res.end(text);\n        });\n    }\n    function teams(c, cb) {\n        var hit = teamsCache[c.provider];\n        if (hit && Date.now() - hit.at < 86400000) { return cb(null, hit.list); }\n        PROVIDERS[c.provider].teams(c, function (err, list) {\n            if (err) { return cb(err); }\n            list.sort(function (a, b) { return a.name < b.name ? -1 : 1; });\n            teamsCache[c.provider] = { at: Date.now(), list: list };\n            cb(null, list);\n        });\n    }\n\n    return {\n        start: function () { running = true; schedule(3000); },\n        stop: function () { running = false; clearTimeout(timer); last = {}; af = { nextKick: 0, liveId: '' }; },\n        status: function () { var c = cfg(); return { provider: c.provider, team: c.teamName, match: status.line || null, error: status.error || null }; },\n        route: function (req, res, sub) {\n            sub = String(sub || '').split('?')[0].replace(/^\\/+|\\/+$/g, '');\n            if (sub === 'ui' && req.method === 'GET') { sendFile(res, 'ui.html', 'text/html; charset=utf-8'); return true; }\n            if (sub === 'state' && req.method === 'GET') { sendJson(res, 200, { config: publicCfg(), status: status, log: log }); return true; }\n            if (sub === 'teams' && req.method === 'GET') {\n                teams(cfg(), function (err, list) { sendJson(res, err ? 502 : 200, err ? { error: String(err) } : { teams: list }); });\n                return true;\n            }\n            if (sub === 'poll' && req.method === 'POST') { poll(); sendJson(res, 200, { ok: true }); return true; }\n            if (sub === 'config' && req.method === 'POST') {\n                readBody(req, function (raw) {\n                    var b, c = cfg(), store = rawCfg();\n                    try { b = JSON.parse(raw); } catch (e) { return sendJson(res, 400, { error: 'invalid JSON' }); }\n                    b = b || {};\n                    if (b.provider !== undefined) {\n                        if (!PROVIDERS.hasOwnProperty(b.provider)) { return sendJson(res, 400, { error: 'unknown provider' }); }\n                        if (b.provider !== c.provider) { c.provider = b.provider; c.teamId = PROVIDERS[b.provider].team.id; c.teamName = PROVIDERS[b.provider].team.name; last = {}; af = { nextKick: 0, liveId: '' }; }\n                    }\n                    if (b.apiKey !== undefined) {\n                        var k = String(b.apiKey).trim();\n                        if (k && !/^[A-Za-z0-9_-]{8,80}$/.test(k)) { return sendJson(res, 400, { error: 'that does not look like an API key' }); }\n                        store.keys = store.keys || {};\n                        if (k) { store.keys[c.provider] = k; } else { delete store.keys[c.provider]; }\n                    }\n                    if (b.teamId !== undefined) {\n                        if (!/^\\d{1,8}$/.test(String(b.teamId))) { return sendJson(res, 400, { error: 'teamId must be a number' }); }\n                        if (String(b.teamId) !== c.teamId) { last = {}; af = { nextKick: 0, liveId: '' }; }\n                        c.teamId = String(b.teamId);\n                    }\n                    if (b.teamName !== undefined) { c.teamName = clean(b.teamName, 40); }\n                    if (b.lang === 'en' || b.lang === 'pt') { c.lang = b.lang; }\n                    if (b.on && typeof b.on === 'object') { Object.keys(c.on).forEach(function (kk) { if (typeof b.on[kk] === 'boolean') { c.on[kk] = b.on[kk]; } }); }\n                    if (b.goalSeconds !== undefined) { c.goalSeconds = clamp(b.goalSeconds, 5, 60, c.goalSeconds); }\n                    if (b.otherSeconds !== undefined) { c.otherSeconds = clamp(b.otherSeconds, 3, 30, c.otherSeconds); }\n                    store.provider = c.provider; store.teamId = c.teamId; store.teamName = c.teamName; store.lang = c.lang; store.on = c.on;\n                    store.goalSeconds = c.goalSeconds; store.otherSeconds = c.otherSeconds;\n                    ctx.config.set(store);\n                    sendJson(res, 200, { config: publicCfg() });\n                    schedule(1000);\n                });\n                return true;\n            }\n            if (sub === 'test' && req.method === 'POST') {\n                readBody(req, function (raw) {\n                    var b = {}, c = cfg(), t = TXT[c.lang];\n                    try { b = JSON.parse(raw) || {}; } catch (e) { b = {}; }\n                    var line = status.line || (c.teamName + ' 1-0 ' + t.test);\n                    if (b.kind === 'against') { banner(t.against + t.test, line, 'warn', E.net, c.otherSeconds); }\n                    else { banner(E.ball + ' ' + t.goal + ' ' + c.teamName.toUpperCase() + '!', line, 'ok', '', c.goalSeconds); }\n                    addLog('test', (b.kind === 'against' ? 'against' : 'goal') + ' - ' + line);\n                    sendJson(res, 200, { ok: true });\n                });\n                return true;\n            }\n            return false;\n        }\n    };\n};\n","match-alerts-0.1.0.vplugin":"{\"format\":\"vetro-plugin\",\"version\":1,\"manifest\":{\"id\":\"match-alerts\",\"apiVersion\":1,\"name\":\"Match alerts\",\"version\":\"0.1.0\",\"description\":\"Follows a football team on ESPN's public scoreboard and shows goals, kick-off, half-time and full-time as TV banners through Notification Center.\",\"author\":\"mclaudiopt\",\"permissions\":[],\"main\":\"index.js\",\"ui\":{\"label\":\"Match alerts\"}},\"files\":{\"README.md\":\"# Match alerts\\n\\nFollows one football team and shows **goals, kick-off, half-time and full-time** as the native Samsung TV banner, on top of whatever is running, through the\\n[Notification Center](https://github.com/mclaudiopt/tv-notification-center) Shard (it must be installed, with its companion app). Everything runs on the TV.\\n\\n## Providers (chosen in the panel)\\n\\n| Provider | Key | Notes |\\n|---|---|---|\\n| **ESPN** (public scoreboard) | none | Default. Unofficial, can change without notice. Polls every 20 s while the team's match is live, every 2-3 minutes otherwise. Covers leagues and cups on one feed (tested with Liga Portugal and the Taca de Portugal). |\\n| **API-Football** | your own key (free plan: 100 requests/day) | **Experimental, not tested without a key.** Spends few requests: checks the team's next fixture, then polls about every 100 s only while the match is live. |\\n\\nOther providers (GOAL API, TheSportsDB, football-data.org) are not implemented: add a provider by writing one `match(config, callback)` function in `index.js`.\\n\\n## What it sends\\n\\nFor the chosen team: **goal** (banner 30 s by default, up to 60), **goal for the opponent**, **goal disallowed**, **kick-off**, **half-time**, **full time**\\n(10 s by default). Each type can be switched off in the panel. A match already in progress when the Shard starts only sets a baseline: no banner for the current score.\\n\\\"Test\\\" buttons send a sample goal or opponent goal.\\n\\n## Network and permissions\\n\\n- Permissions: none (no `exec`).\\n- Outgoing: HTTPS GET to `site.api.espn.com` (ESPN) or `v3.football.api-sports.io` (API-Football, with your key), and one local call, `POST /plugins/notification-center/api/notify` on `127.0.0.1:8099`.\\n- Stored in `ctx.config`: provider, team, options and, if you set one, the API-Football key (on the TV only; the panel never shows it back).\\n- The match log and state are in memory only.\\n\\n## Install\\n\\nInstall `match-alerts-0.1.0.vplugin` as a file in Vetro (Developer mode), switch it on, open the **Match alerts** tab, pick the team and press \\\"Test: goal\\\".\\nNeeds Notification Center 0.2.1 or newer (banner mode).\\n\",\"index.js\":\"'use strict';\\n// Match alerts: follows one football team through a score provider of your choice and sends banners through the Notification Center Shard.\\n// Providers: ESPN (public scoreboard, no key) and API-Football (needs your own key, 100 requests/day on the free plan, experimental).\\n// Plain ES5 (older TVs run Node 4.4). Outgoing: HTTPS GET to the chosen provider, and POST notify to Vetro on 127.0.0.1:8099.\\nvar fs = require('fs');\\nvar path = require('path');\\nvar http = require('http');\\nvar https = require('https');\\n\\nvar NOTIFY = '/plugins/notification-center/api/notify';\\nvar MAX_BODY = 4096, MAX_LOG = 30;\\nvar E = {\\n    ball: String.fromCharCode(0x26BD),\\n    net: String.fromCharCode(0xD83E, 0xDD45),\\n    no: String.fromCharCode(0xD83D, 0xDEAB),\\n    flag: String.fromCharCode(0xD83C, 0xDFC1),\\n    whistle: String.fromCharCode(0x23F1, 0xFE0F),\\n    pause: String.fromCharCode(0x23F8, 0xFE0F)\\n};\\nvar DEFAULTS = {\\n    provider: 'espn', teamId: '2250', teamName: 'Sporting CP', lang: 'en',\\n    on: { goal: true, against: true, start: true, half: true, end: true },\\n    goalSeconds: 30, otherSeconds: 10\\n};\\nvar TXT = {\\n    en: { goal: 'GOAL', against: 'Goal for ', varNo: 'Goal disallowed', start: 'Kick-off', half: 'Half-time', end: 'Full time', test: 'Test' },\\n    pt: { goal: 'GOLO', against: 'Golo do ', varNo: 'Golo anulado', start: 'Come' + String.fromCharCode(0xE7) + 'ou o jogo', half: 'Intervalo', end: 'Fim do jogo', test: 'Teste' }\\n};\\n\\nmodule.exports = function (ctx) {\\n    var timer = null, running = false;\\n    var last = {};                       // per match id: { state, desc, our, opp } (memory only)\\n    var log = [], teamsCache = {}, status = { at: 0, error: '', line: '', state: '', next: 0 };\\n    var af = { nextKick: 0, liveId: '' };   // API-Football bookkeeping, to spend few of the 100 daily requests\\n\\n    function clamp(v, lo, hi, def) { var n = parseInt(v, 10); if (!(n >= lo)) { return def; } return n > hi ? hi : n; }\\n    function clean(s, max) { return String(s == null ? '' : s).replace(/[\\\\x00-\\\\x1f]/g, ' ').slice(0, max); }\\n    function sendJson(res, code, obj) { res.writeHead(code, { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store' }); res.end(JSON.stringify(obj)); }\\n    function readBody(req, cb) {\\n        var s = '';\\n        req.on('data', function (d) { s += d; if (s.length > MAX_BODY) { req.destroy(); } });\\n        req.on('end', function () { cb(s); });\\n    }\\n    function addLog(kind, text) {\\n        log.unshift({ at: Date.now(), kind: kind, text: clean(text, 200) });\\n        if (log.length > MAX_LOG) { log.pop(); }\\n    }\\n\\n    // ---- generic HTTPS JSON GET -------------------------------------------------------------------------------------------------\\n    function getJson(host, p, headers, cb) {\\n        var done = false;\\n        function end(err, data) { if (!done) { done = true; cb(err, data); } }\\n        var h = { 'Accept-Encoding': 'identity', 'User-Agent': 'vetro-match-alerts' }, k;\\n        for (k in headers) { if (headers.hasOwnProperty(k)) { h[k] = headers[k]; } }\\n        try {\\n            var rq = https.get({ host: host, path: p, headers: h, timeout: 10000 }, function (r) {\\n                var s = '';\\n                r.setEncoding('utf8');\\n                r.on('data', function (d) { s += d; if (s.length > 3000000) { r.destroy(); end('too large'); } });\\n                r.on('end', function () {\\n                    if (r.statusCode !== 200) { return end('http ' + r.statusCode); }\\n                    try { end(null, JSON.parse(s)); } catch (e) { end('bad json'); }\\n                });\\n            });\\n            rq.on('error', function (e) { end(String(e && e.message || e)); });\\n            rq.on('timeout', function () { rq.destroy(); end('timeout'); });\\n        } catch (e) { end('request failed'); }\\n    }\\n\\n    // ---- providers: each gives the team's match as { id, state: pre|in|post, desc, clock, date, home, away } -----------------------\\n    // home / away = { id, name, short, score }\\n    function espnMatch(c, cb) {\\n        getJson('site.api.espn.com', '/apis/site/v2/sports/soccer/all/scoreboard', {}, function (err, data) {\\n            if (err) { return cb(err); }\\n            var evs = (data && data.events) || [], i, j, m = null;\\n            for (i = 0; i < evs.length && !m; i++) {\\n                var cs = (evs[i].competitions && evs[i].competitions[0] && evs[i].competitions[0].competitors) || [], home = null, away = null;\\n                for (j = 0; j < cs.length; j++) {\\n                    var side = { id: String(cs[j].team.id), name: cs[j].team.displayName, short: cs[j].team.shortDisplayName || cs[j].team.displayName, score: parseInt(cs[j].score, 10) || 0 };\\n                    if (cs[j].homeAway === 'home') { home = side; } else { away = side; }\\n                }\\n                if (home && away && (home.id === c.teamId || away.id === c.teamId)) {\\n                    var t = evs[i].status && evs[i].status.type ? evs[i].status.type : {};\\n                    m = { id: 'espn-' + evs[i].id, state: t.state || '', desc: t.description || '', clock: evs[i].status.displayClock || '', date: evs[i].date, home: home, away: away };\\n                }\\n            }\\n            cb(null, m, m ? { wait: m.state === 'in' ? 20000 : (m.state === 'pre' && new Date(m.date).getTime() - Date.now() < 900000 ? 30000 : 120000) } : { wait: 180000 });\\n        });\\n    }\\n    function espnTeams(c, cb) {\\n        getJson('site.api.espn.com', '/apis/site/v2/sports/soccer/por.1/teams', {}, function (err, d) {\\n            if (err) { return cb(err); }\\n            var list = [];\\n            try { d.sports[0].leagues[0].teams.forEach(function (t) { list.push({ id: String(t.team.id), name: t.team.displayName }); }); } catch (e) { return cb('unexpected answer'); }\\n            cb(null, list);\\n        });\\n    }\\n\\n    function afGet(c, p, cb) {\\n        var key = (ctx.config.get() || {}).keys && (ctx.config.get() || {}).keys.apifootball;\\n        if (!key) { return cb('no API-Football key set'); }\\n        getJson('v3.football.api-sports.io', p, { 'x-apisports-key': key }, function (err, d) {\\n            if (err) { return cb(err); }\\n            var e = d && d.errors;\\n            if (e && ((Array.isArray(e) && e.length) || (!Array.isArray(e) && Object.keys(e).length))) { return cb('API-Football: ' + clean(JSON.stringify(e), 120)); }\\n            cb(null, (d && d.response) || []);\\n        });\\n    }\\n    function afNorm(f) {\\n        var s = f.fixture.status.short, st = (s === 'NS' || s === 'TBD' || s === 'PST') ? 'pre' : (s === 'FT' || s === 'AET' || s === 'PEN' || s === 'CANC' || s === 'ABD' || s === 'AWD' || s === 'WO') ? 'post' : 'in';\\n        return {\\n            id: 'af-' + f.fixture.id, state: st, desc: s === 'HT' ? 'Halftime' : f.fixture.status.long, clock: f.fixture.status.elapsed ? f.fixture.status.elapsed + \\\"'\\\" : '', date: f.fixture.date,\\n            home: { id: String(f.teams.home.id), name: f.teams.home.name, short: f.teams.home.name, score: f.goals.home || 0 },\\n            away: { id: String(f.teams.away.id), name: f.teams.away.name, short: f.teams.away.name, score: f.goals.away || 0 }\\n        };\\n    }\\n    function afMatch(c, cb) {\\n        var now = Date.now();\\n        if (af.nextKick && now < af.nextKick - 300000) { return cb(null, null, { wait: Math.min(af.nextKick - 300000 - now, 7200000) }); }\\n        function schedule() {   // one request: the team's next fixture\\n            afGet(c, '/fixtures?team=' + c.teamId + '&next=1', function (err, list) {\\n                if (err) { return cb(err); }\\n                af.nextKick = list[0] ? new Date(list[0].fixture.date).getTime() : now + 7200000;\\n                cb(null, null, { wait: Math.min(Math.max(af.nextKick - 300000 - Date.now(), 60000), 7200000) });\\n            });\\n        }\\n        if (af.liveId) {   // a match we saw live: ask for it directly so the final whistle is not missed\\n            return afGet(c, '/fixtures?id=' + af.liveId.replace(/\\\\D/g, ''), function (err, list) {\\n                if (err) { return cb(err); }\\n                var m = list[0] ? afNorm(list[0]) : null;\\n                if (!m || m.state === 'post') { af.liveId = ''; af.nextKick = 0; }\\n                cb(null, m, { wait: 100000 });\\n            });\\n        }\\n        afGet(c, '/fixtures?live=all', function (err, list) {\\n            if (err) { return cb(err); }\\n            var i, m = null;\\n            for (i = 0; i < list.length && !m; i++) {\\n                if (String(list[i].teams.home.id) === c.teamId || String(list[i].teams.away.id) === c.teamId) { m = afNorm(list[i]); }\\n            }\\n            if (m) { af.liveId = m.id; return cb(null, m, { wait: 100000 }); }\\n            if (af.nextKick && now >= af.nextKick - 300000 && now < af.nextKick + 1800000) { return cb(null, null, { wait: 100000 }); }   // about to start\\n            schedule();\\n        });\\n    }\\n    function afTeams(c, cb) {\\n        var d = new Date(), season = d.getMonth() < 6 ? d.getFullYear() - 1 : d.getFullYear();\\n        afGet(c, '/teams?league=94&season=' + season, function (err, list) {\\n            if (err) { return cb(err); }\\n            cb(null, list.map(function (t) { return { id: String(t.team.id), name: t.team.name }; }));\\n        });\\n    }\\n    var PROVIDERS = {\\n        espn: { label: 'ESPN (public scoreboard, no key)', needsKey: false, team: { id: '2250', name: 'Sporting CP' }, match: espnMatch, teams: espnTeams },\\n        apifootball: { label: 'API-Football (your key, 100 requests/day, experimental)', needsKey: true, team: { id: '228', name: 'Sporting CP' }, match: afMatch, teams: afTeams }\\n    };\\n\\n    // ---- config ----------------------------------------------------------------------------------------------------------------\\n    function rawCfg() { return ctx.config.get() || {}; }\\n    function cfg() {\\n        var c = rawCfg(), d = DEFAULTS, o = {};\\n        o.provider = PROVIDERS.hasOwnProperty(c.provider) ? c.provider : d.provider;\\n        o.teamId = /^\\\\d{1,8}$/.test(String(c.teamId)) ? String(c.teamId) : PROVIDERS[o.provider].team.id;\\n        o.teamName = clean(c.teamName || PROVIDERS[o.provider].team.name, 40);\\n        o.lang = c.lang === 'pt' ? 'pt' : 'en';\\n        o.on = {};\\n        Object.keys(d.on).forEach(function (k) { o.on[k] = !(c.on && c.on[k] === false); });\\n        o.goalSeconds = clamp(c.goalSeconds, 5, 60, d.goalSeconds);\\n        o.otherSeconds = clamp(c.otherSeconds, 3, 30, d.otherSeconds);\\n        return o;\\n    }\\n    function publicCfg() {\\n        var o = cfg(), keys = rawCfg().keys || {};\\n        o.hasKey = !!keys[o.provider];\\n        o.providers = Object.keys(PROVIDERS).map(function (k) { return { id: k, label: PROVIDERS[k].label, needsKey: PROVIDERS[k].needsKey }; });\\n        return o;\\n    }\\n\\n    // ---- banners ---------------------------------------------------------------------------------------------------------------\\n    function banner(title, message, level, icon, seconds) {\\n        var body = JSON.stringify({ title: title, message: message, level: level, icon: icon, mode: 'banner', duration: seconds });\\n        try {\\n            var rq = http.request({\\n                host: '127.0.0.1', port: 8099, path: NOTIFY, method: 'POST', timeout: 5000,\\n                headers: { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(body) }\\n            }, function (r) { r.resume(); });\\n            rq.on('error', function () { /* Notification Center not installed or Vetro busy */ });\\n            rq.on('timeout', function () { rq.destroy(); });\\n            rq.write(body);\\n            rq.end();\\n        } catch (e) { /* ignore */ }\\n    }\\n    function lineOf(m) { return m.home.name + ' ' + m.home.score + '-' + m.away.score + ' ' + m.away.name + (m.clock ? ' (' + m.clock + ')' : ''); }\\n    function announce(kind, c, m, extra) {\\n        var t = TXT[c.lang], line = lineOf(m), seconds = c.otherSeconds, title, level = 'info', icon = '';\\n        if (kind === 'goal') { title = E.ball + ' ' + t.goal + ' ' + c.teamName.toUpperCase() + '!'; level = 'ok'; seconds = c.goalSeconds; }\\n        else if (kind === 'against') { title = t.against + (extra || '?'); level = 'warn'; icon = E.net; }\\n        else if (kind === 'var') { title = t.varNo; level = 'warn'; icon = E.no; }\\n        else if (kind === 'start') { title = t.start; icon = E.whistle; }\\n        else if (kind === 'half') { title = t.half; icon = E.pause; }\\n        else { title = t.end; icon = E.flag; }\\n        banner(title, line, level, icon, seconds);   // the goal title already carries the ball, so it has no separate icon\\n        addLog(kind, title + ' - ' + line);\\n    }\\n    function analyse(m, c) {\\n        var us = m.home.id === c.teamId ? m.home : m.away, them = us === m.home ? m.away : m.home;\\n        var prev = last[m.id];\\n        last[m.id] = { state: m.state, desc: m.desc, our: us.score, opp: them.score };\\n        status.line = lineOf(m); status.state = m.desc;\\n        if (!prev) { return; }                                    // first sight: baseline only, no banner\\n        if (us.score > prev.our && c.on.goal) { announce('goal', c, m); }\\n        else if (them.score > prev.opp && c.on.against) { announce('against', c, m, them.short); }\\n        else if ((us.score < prev.our || them.score < prev.opp) && (c.on.goal || c.on.against)) { announce('var', c, m); }\\n        if (prev.state === 'pre' && m.state === 'in' && c.on.start) { announce('start', c, m); }\\n        if (/half/i.test(m.desc) && !/half/i.test(prev.desc) && c.on.half) { announce('half', c, m); }\\n        if (prev.state === 'in' && m.state === 'post' && c.on.end) { announce('end', c, m); }\\n    }\\n\\n    // ---- polling ---------------------------------------------------------------------------------------------------------------\\n    function schedule(ms) {\\n        if (!running) { return; }\\n        status.next = Date.now() + ms;\\n        clearTimeout(timer);\\n        timer = setTimeout(poll, ms);\\n    }\\n    function poll() {\\n        if (!running) { return; }\\n        var c = cfg();\\n        PROVIDERS[c.provider].match(c, function (err, m, hint) {\\n            status.at = Date.now();\\n            if (err) { status.error = String(err); return schedule(120000); }\\n            status.error = '';\\n            if (!m) { status.line = ''; status.state = ''; return schedule((hint && hint.wait) || 180000); }\\n            analyse(m, c);\\n            schedule((hint && hint.wait) || 60000);\\n        });\\n    }\\n\\n    function sendFile(res, name, type) {\\n        fs.readFile(path.join(__dirname, name), 'utf8', function (err, text) {\\n            if (err) { return sendJson(res, 500, { error: name + ' is missing' }); }\\n            res.writeHead(200, { 'Content-Type': type, 'Cache-Control': 'no-store' });\\n            res.end(text);\\n        });\\n    }\\n    function teams(c, cb) {\\n        var hit = teamsCache[c.provider];\\n        if (hit && Date.now() - hit.at < 86400000) { return cb(null, hit.list); }\\n        PROVIDERS[c.provider].teams(c, function (err, list) {\\n            if (err) { return cb(err); }\\n            list.sort(function (a, b) { return a.name < b.name ? -1 : 1; });\\n            teamsCache[c.provider] = { at: Date.now(), list: list };\\n            cb(null, list);\\n        });\\n    }\\n\\n    return {\\n        start: function () { running = true; schedule(3000); },\\n        stop: function () { running = false; clearTimeout(timer); last = {}; af = { nextKick: 0, liveId: '' }; },\\n        status: function () { var c = cfg(); return { provider: c.provider, team: c.teamName, match: status.line || null, error: status.error || null }; },\\n        route: function (req, res, sub) {\\n            sub = String(sub || '').split('?')[0].replace(/^\\\\/+|\\\\/+$/g, '');\\n            if (sub === 'ui' && req.method === 'GET') { sendFile(res, 'ui.html', 'text/html; charset=utf-8'); return true; }\\n            if (sub === 'state' && req.method === 'GET') { sendJson(res, 200, { config: publicCfg(), status: status, log: log }); return true; }\\n            if (sub === 'teams' && req.method === 'GET') {\\n                teams(cfg(), function (err, list) { sendJson(res, err ? 502 : 200, err ? { error: String(err) } : { teams: list }); });\\n                return true;\\n            }\\n            if (sub === 'poll' && req.method === 'POST') { poll(); sendJson(res, 200, { ok: true }); return true; }\\n            if (sub === 'config' && req.method === 'POST') {\\n                readBody(req, function (raw) {\\n                    var b, c = cfg(), store = rawCfg();\\n                    try { b = JSON.parse(raw); } catch (e) { return sendJson(res, 400, { error: 'invalid JSON' }); }\\n                    b = b || {};\\n                    if (b.provider !== undefined) {\\n                        if (!PROVIDERS.hasOwnProperty(b.provider)) { return sendJson(res, 400, { error: 'unknown provider' }); }\\n                        if (b.provider !== c.provider) { c.provider = b.provider; c.teamId = PROVIDERS[b.provider].team.id; c.teamName = PROVIDERS[b.provider].team.name; last = {}; af = { nextKick: 0, liveId: '' }; }\\n                    }\\n                    if (b.apiKey !== undefined) {\\n                        var k = String(b.apiKey).trim();\\n                        if (k && !/^[A-Za-z0-9_-]{8,80}$/.test(k)) { return sendJson(res, 400, { error: 'that does not look like an API key' }); }\\n                        store.keys = store.keys || {};\\n                        if (k) { store.keys[c.provider] = k; } else { delete store.keys[c.provider]; }\\n                    }\\n                    if (b.teamId !== undefined) {\\n                        if (!/^\\\\d{1,8}$/.test(String(b.teamId))) { return sendJson(res, 400, { error: 'teamId must be a number' }); }\\n                        if (String(b.teamId) !== c.teamId) { last = {}; af = { nextKick: 0, liveId: '' }; }\\n                        c.teamId = String(b.teamId);\\n                    }\\n                    if (b.teamName !== undefined) { c.teamName = clean(b.teamName, 40); }\\n                    if (b.lang === 'en' || b.lang === 'pt') { c.lang = b.lang; }\\n                    if (b.on && typeof b.on === 'object') { Object.keys(c.on).forEach(function (kk) { if (typeof b.on[kk] === 'boolean') { c.on[kk] = b.on[kk]; } }); }\\n                    if (b.goalSeconds !== undefined) { c.goalSeconds = clamp(b.goalSeconds, 5, 60, c.goalSeconds); }\\n                    if (b.otherSeconds !== undefined) { c.otherSeconds = clamp(b.otherSeconds, 3, 30, c.otherSeconds); }\\n                    store.provider = c.provider; store.teamId = c.teamId; store.teamName = c.teamName; store.lang = c.lang; store.on = c.on;\\n                    store.goalSeconds = c.goalSeconds; store.otherSeconds = c.otherSeconds;\\n                    ctx.config.set(store);\\n                    sendJson(res, 200, { config: publicCfg() });\\n                    schedule(1000);\\n                });\\n                return true;\\n            }\\n            if (sub === 'test' && req.method === 'POST') {\\n                readBody(req, function (raw) {\\n                    var b = {}, c = cfg(), t = TXT[c.lang];\\n                    try { b = JSON.parse(raw) || {}; } catch (e) { b = {}; }\\n                    var line = status.line || (c.teamName + ' 1-0 ' + t.test);\\n                    if (b.kind === 'against') { banner(t.against + t.test, line, 'warn', E.net, c.otherSeconds); }\\n                    else { banner(E.ball + ' ' + t.goal + ' ' + c.teamName.toUpperCase() + '!', line, 'ok', '', c.goalSeconds); }\\n                    addLog('test', (b.kind === 'against' ? 'against' : 'goal') + ' - ' + line);\\n                    sendJson(res, 200, { ok: true });\\n                });\\n                return true;\\n            }\\n            return false;\\n        }\\n    };\\n};\\n\",\"ui.html\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\">\\n<meta name=\\\"color-scheme\\\" content=\\\"dark light\\\">\\n<title>Match alerts</title>\\n<style>\\n:root { --bg: #0b0e14; --card: #161b26; --line: #262e3f; --txt: #eef2f9; --dim: #8b96ab; --acc: #2f7bff; --ok: #2fc28b; --alert: #f0506e; }\\n* { box-sizing: border-box; }\\nbody { margin: 0; padding: 16px; font: 15px/1.45 \\\"Segoe UI\\\", system-ui, sans-serif; background: var(--bg); color: var(--txt); }\\n.head { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }\\n.logo { width: 42px; height: 42px; border-radius: 12px; background: linear-gradient(135deg, #2fc28b, #2f7bff); display: grid; place-items: center; font-size: 22px; }\\nh1 { font-size: 20px; margin: 0; flex: 1; font-weight: 600; }\\n.lang { display: flex; background: var(--card); border: 1px solid var(--line); border-radius: 20px; overflow: hidden; }\\n.lang button { border: 0; background: none; color: var(--dim); padding: 6px 12px; cursor: pointer; font: inherit; }\\n.lang button.on { background: var(--acc); color: #fff; }\\n.grid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); }\\n.card { background: var(--card); border: 1px solid var(--line); border-radius: 20px; padding: 16px; }\\nh2 { font-size: 13px; letter-spacing: .06em; text-transform: uppercase; color: var(--dim); margin: 0 0 12px; font-weight: 600; }\\nlabel.f { display: block; color: var(--dim); font-size: 13px; margin: 10px 0 4px; }\\ninput, select, button { font: inherit; color: inherit; }\\ninput[type=text], input[type=password], select { width: 100%; background: #0f131c; border: 1px solid var(--line); border-radius: 12px; padding: 10px 12px; }\\ninput:focus, select:focus { outline: 2px solid var(--acc); border-color: transparent; }\\n.row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }\\n.row.sp { margin-top: 10px; }\\n.chk { display: flex; align-items: center; gap: 8px; color: var(--txt); padding: 4px 0; }\\n.dur { display: flex; align-items: center; gap: 12px; color: var(--dim); font-size: 13px; margin-top: 8px; }\\n.dur input { flex: 1; accent-color: var(--acc); }\\n.dur b { color: var(--txt); min-width: 44px; text-align: right; }\\nbutton.p { background: var(--acc); border: 0; border-radius: 20px; padding: 8px 20px; cursor: pointer; font-weight: 600; color: #fff; }\\nbutton.g { background: none; border: 1px solid var(--line); border-radius: 18px; padding: 6px 14px; cursor: pointer; color: var(--dim); }\\n.msg { min-height: 20px; margin-top: 8px; font-size: 13px; color: var(--dim); } .ok { color: var(--ok); } .err { color: var(--alert); }\\n.live { font-size: 18px; font-weight: 600; margin: 4px 0; }\\nul { list-style: none; margin: 0; padding: 0; }\\nli { padding: 8px 0; border-bottom: 1px solid var(--line); } li:last-child { border: 0; } li small { color: var(--dim); display: block; }\\n.empty { color: var(--dim); text-align: center; padding: 14px 0; }\\n[hidden] { display: none !important; }\\n</style>\\n</head>\\n<body>\\n<div class=\\\"head\\\">\\n  <div class=\\\"logo\\\">&#9917;</div>\\n  <h1 data-t=\\\"title\\\">Match alerts</h1>\\n  <div class=\\\"lang\\\"><button type=\\\"button\\\" id=\\\"l-en\\\">EN</button><button type=\\\"button\\\" id=\\\"l-pt\\\">PT</button></div>\\n</div>\\n<div class=\\\"grid\\\">\\n  <div class=\\\"card\\\">\\n    <h2 data-t=\\\"source\\\">Score source</h2>\\n    <label class=\\\"f\\\" data-t=\\\"provider\\\">Provider</label>\\n    <select id=\\\"provider\\\"></select>\\n    <div id=\\\"keybox\\\" hidden>\\n      <label class=\\\"f\\\" data-t=\\\"apikey\\\">API key (stored on the TV only)</label>\\n      <div class=\\\"row\\\"><input type=\\\"password\\\" id=\\\"apikey\\\" style=\\\"flex:1\\\" autocomplete=\\\"off\\\"><button type=\\\"button\\\" class=\\\"g\\\" id=\\\"savekey\\\" data-t=\\\"save\\\">Save</button></div>\\n      <div class=\\\"msg\\\" id=\\\"keystate\\\"></div>\\n    </div>\\n    <label class=\\\"f\\\" data-t=\\\"team\\\">Team</label>\\n    <select id=\\\"team\\\"></select>\\n    <div class=\\\"msg\\\" id=\\\"teamnote\\\"></div>\\n    <div class=\\\"msg\\\" id=\\\"result\\\"></div>\\n  </div>\\n  <div class=\\\"card\\\">\\n    <h2 data-t=\\\"now\\\">Right now</h2>\\n    <div class=\\\"live\\\" id=\\\"line\\\">-</div>\\n    <div class=\\\"msg\\\" id=\\\"stat\\\"></div>\\n    <div class=\\\"row sp\\\"><button type=\\\"button\\\" class=\\\"g\\\" id=\\\"poll\\\" data-t=\\\"check\\\">Check now</button></div>\\n  </div>\\n  <div class=\\\"card\\\">\\n    <h2 data-t=\\\"alerts\\\">Alerts</h2>\\n    <label class=\\\"chk\\\"><input type=\\\"checkbox\\\" data-on=\\\"goal\\\"> <span data-t=\\\"a_goal\\\">Goal for my team</span></label>\\n    <label class=\\\"chk\\\"><input type=\\\"checkbox\\\" data-on=\\\"against\\\"> <span data-t=\\\"a_against\\\">Goal for the opponent</span></label>\\n    <label class=\\\"chk\\\"><input type=\\\"checkbox\\\" data-on=\\\"start\\\"> <span data-t=\\\"a_start\\\">Kick-off</span></label>\\n    <label class=\\\"chk\\\"><input type=\\\"checkbox\\\" data-on=\\\"half\\\"> <span data-t=\\\"a_half\\\">Half-time</span></label>\\n    <label class=\\\"chk\\\"><input type=\\\"checkbox\\\" data-on=\\\"end\\\"> <span data-t=\\\"a_end\\\">Full time</span></label>\\n    <div class=\\\"dur\\\"><span data-t=\\\"goalsec\\\">Goal banner (s)</span><input type=\\\"range\\\" id=\\\"goalsec\\\" min=\\\"5\\\" max=\\\"60\\\"><b id=\\\"goalsecv\\\"></b></div>\\n    <div class=\\\"dur\\\"><span data-t=\\\"othersec\\\">Other banners (s)</span><input type=\\\"range\\\" id=\\\"othersec\\\" min=\\\"3\\\" max=\\\"30\\\"><b id=\\\"othersecv\\\"></b></div>\\n    <div class=\\\"row sp\\\"><button type=\\\"button\\\" class=\\\"p\\\" id=\\\"save\\\" data-t=\\\"save\\\">Save</button><button type=\\\"button\\\" class=\\\"g\\\" id=\\\"tg\\\" data-t=\\\"testgoal\\\">Test: goal</button><button type=\\\"button\\\" class=\\\"g\\\" id=\\\"ta\\\" data-t=\\\"testag\\\">Test: goal against</button></div>\\n  </div>\\n  <div class=\\\"card\\\">\\n    <h2 data-t=\\\"recent\\\">Recent alerts</h2>\\n    <ul id=\\\"log\\\"></ul>\\n  </div>\\n</div>\\n<script>\\n(function () {\\n  \\\"use strict\\\";\\n  var $ = function (id) { return document.getElementById(id); };\\n  var T = {\\n    en: { title: \\\"Match alerts\\\", source: \\\"Score source\\\", provider: \\\"Provider\\\", apikey: \\\"API key (stored on the TV only)\\\", save: \\\"Save\\\", team: \\\"Team\\\", now: \\\"Right now\\\", check: \\\"Check now\\\",\\n      alerts: \\\"Alerts\\\", a_goal: \\\"Goal for my team\\\", a_against: \\\"Goal for the opponent\\\", a_start: \\\"Kick-off\\\", a_half: \\\"Half-time\\\", a_end: \\\"Full time\\\",\\n      goalsec: \\\"Goal banner (s)\\\", othersec: \\\"Other banners (s)\\\", testgoal: \\\"Test: goal\\\", testag: \\\"Test: goal against\\\", recent: \\\"Recent alerts\\\",\\n      nomatch: \\\"No match for this team right now.\\\", saved: \\\"Saved.\\\", keyset: \\\"A key is saved.\\\", keynone: \\\"No key saved yet.\\\", noneyet: \\\"Nothing yet.\\\", checked: \\\"Last check: \\\", err: \\\"Error: \\\", sent: \\\"Test sent.\\\", loadteams: \\\"Could not load the team list: \\\" },\\n    pt: { title: \\\"Alertas de jogo\\\", source: \\\"Fonte de resultados\\\", provider: \\\"Fornecedor\\\", apikey: \\\"Chave da API (guardada s\\\\u00F3 na TV)\\\", save: \\\"Guardar\\\", team: \\\"Equipa\\\", now: \\\"Agora\\\", check: \\\"Verificar agora\\\",\\n      alerts: \\\"Alertas\\\", a_goal: \\\"Golo da minha equipa\\\", a_against: \\\"Golo do advers\\\\u00E1rio\\\", a_start: \\\"In\\\\u00EDcio do jogo\\\", a_half: \\\"Intervalo\\\", a_end: \\\"Fim do jogo\\\",\\n      goalsec: \\\"Banner de golo (s)\\\", othersec: \\\"Outros banners (s)\\\", testgoal: \\\"Teste: golo\\\", testag: \\\"Teste: golo sofrido\\\", recent: \\\"Alertas recentes\\\",\\n      nomatch: \\\"Sem jogo desta equipa neste momento.\\\", saved: \\\"Guardado.\\\", keyset: \\\"H\\\\u00E1 uma chave guardada.\\\", keynone: \\\"Ainda sem chave.\\\", noneyet: \\\"Ainda nada.\\\", checked: \\\"\\\\u00DAltima verifica\\\\u00E7\\\\u00E3o: \\\", err: \\\"Erro: \\\", sent: \\\"Teste enviado.\\\", loadteams: \\\"N\\\\u00E3o foi poss\\\\u00EDvel carregar as equipas: \\\" }\\n  };\\n  var lang = \\\"en\\\", cfg = null;\\n  function tr(k) { return T[lang][k] || T.en[k] || k; }\\n  function esc(s) { return String(s == null ? \\\"\\\" : s).replace(/[&<>\\\"']/g, function (c) { return { \\\"&\\\": \\\"&amp;\\\", \\\"<\\\": \\\"&lt;\\\", \\\">\\\": \\\"&gt;\\\", '\\\"': \\\"&quot;\\\", \\\"'\\\": \\\"&#39;\\\" }[c]; }); }\\n  function say(t, cls) { $(\\\"result\\\").textContent = t || \\\"\\\"; $(\\\"result\\\").className = \\\"msg \\\" + (cls || \\\"\\\"); }\\n  function api(path, body) {\\n    var opt = body ? { method: \\\"POST\\\", headers: { \\\"Content-Type\\\": \\\"application/json\\\" }, body: JSON.stringify(body) } : {};\\n    return fetch(path, opt).then(function (r) { return r.json().then(function (j) { if (!r.ok) { throw new Error(j.error || \\\"error \\\" + r.status); } return j; }); });\\n  }\\n  function applyText() {\\n    document.documentElement.lang = lang;\\n    var els = document.querySelectorAll(\\\"[data-t]\\\"), i;\\n    for (i = 0; i < els.length; i++) { els[i].textContent = tr(els[i].getAttribute(\\\"data-t\\\")); }\\n    $(\\\"l-en\\\").className = lang === \\\"en\\\" ? \\\"on\\\" : \\\"\\\"; $(\\\"l-pt\\\").className = lang === \\\"pt\\\" ? \\\"on\\\" : \\\"\\\";\\n  }\\n  function fill() {\\n    if (!cfg) { return; }\\n    var i, p = $(\\\"provider\\\"), prov;\\n    p.innerHTML = cfg.providers.map(function (x) { return '<option value=\\\"' + esc(x.id) + '\\\">' + esc(x.label) + \\\"</option>\\\"; }).join(\\\"\\\");\\n    p.value = cfg.provider;\\n    for (i = 0; i < cfg.providers.length; i++) { if (cfg.providers[i].id === cfg.provider) { prov = cfg.providers[i]; } }\\n    $(\\\"keybox\\\").hidden = !(prov && prov.needsKey);\\n    $(\\\"keystate\\\").textContent = cfg.hasKey ? tr(\\\"keyset\\\") : tr(\\\"keynone\\\");\\n    var boxes = document.querySelectorAll(\\\"[data-on]\\\");\\n    for (i = 0; i < boxes.length; i++) { boxes[i].checked = !!cfg.on[boxes[i].getAttribute(\\\"data-on\\\")]; }\\n    $(\\\"goalsec\\\").value = cfg.goalSeconds; $(\\\"goalsecv\\\").textContent = cfg.goalSeconds + \\\" s\\\";\\n    $(\\\"othersec\\\").value = cfg.otherSeconds; $(\\\"othersecv\\\").textContent = cfg.otherSeconds + \\\" s\\\";\\n  }\\n  function teams() {\\n    api(\\\"teams\\\").then(function (d) {\\n      var sel = $(\\\"team\\\"), found = false;\\n      sel.innerHTML = d.teams.map(function (t) { if (t.id === cfg.teamId) { found = true; } return '<option value=\\\"' + esc(t.id) + '\\\">' + esc(t.name) + \\\"</option>\\\"; }).join(\\\"\\\");\\n      if (!found) { sel.insertAdjacentHTML(\\\"afterbegin\\\", '<option value=\\\"' + esc(cfg.teamId) + '\\\">' + esc(cfg.teamName) + \\\"</option>\\\"); }\\n      sel.value = cfg.teamId; $(\\\"teamnote\\\").textContent = \\\"\\\";\\n    }).catch(function (e) { $(\\\"team\\\").innerHTML = '<option value=\\\"' + esc(cfg.teamId) + '\\\">' + esc(cfg.teamName) + \\\"</option>\\\"; $(\\\"teamnote\\\").textContent = tr(\\\"loadteams\\\") + e.message; });\\n  }\\n  function state() {\\n    return api(\\\"state\\\").then(function (d) {\\n      var first = !cfg || cfg.provider !== d.config.provider; cfg = d.config;\\n      fill(); if (first) { teams(); }\\n      $(\\\"line\\\").textContent = d.status.line || tr(\\\"nomatch\\\");\\n      $(\\\"stat\\\").textContent = (d.status.state ? d.status.state + \\\" \\\\u00B7 \\\" : \\\"\\\") + (d.status.at ? tr(\\\"checked\\\") + new Date(d.status.at).toLocaleTimeString() : \\\"\\\") + (d.status.error ? \\\" \\\\u00B7 \\\" + tr(\\\"err\\\") + d.status.error : \\\"\\\");\\n      $(\\\"log\\\").innerHTML = d.log.length ? d.log.map(function (e) { return \\\"<li>\\\" + esc(e.text) + \\\"<small>\\\" + new Date(e.at).toLocaleTimeString() + \\\"</small></li>\\\"; }).join(\\\"\\\") : '<li class=\\\"empty\\\">' + esc(tr(\\\"noneyet\\\")) + \\\"</li>\\\";\\n    }).catch(function (e) { say(tr(\\\"err\\\") + e.message, \\\"err\\\"); });\\n  }\\n  function body() {\\n    var on = {}, boxes = document.querySelectorAll(\\\"[data-on]\\\"), i;\\n    for (i = 0; i < boxes.length; i++) { on[boxes[i].getAttribute(\\\"data-on\\\")] = boxes[i].checked; }\\n    var sel = $(\\\"team\\\"), opt = sel.options[sel.selectedIndex];\\n    return { teamId: sel.value, teamName: opt ? opt.text : \\\"\\\", on: on, goalSeconds: parseInt($(\\\"goalsec\\\").value, 10), otherSeconds: parseInt($(\\\"othersec\\\").value, 10), lang: lang };\\n  }\\n  // The dashboard frame has no allow-forms: buttons only.\\n  $(\\\"provider\\\").addEventListener(\\\"change\\\", function () { cfg = null; api(\\\"config\\\", { provider: this.value }).then(function () { state(); }).catch(function (e) { say(e.message, \\\"err\\\"); }); });\\n  $(\\\"savekey\\\").addEventListener(\\\"click\\\", function () { api(\\\"config\\\", { apiKey: $(\\\"apikey\\\").value }).then(function () { $(\\\"apikey\\\").value = \\\"\\\"; say(tr(\\\"saved\\\"), \\\"ok\\\"); state(); }).catch(function (e) { say(e.message, \\\"err\\\"); }); });\\n  $(\\\"save\\\").addEventListener(\\\"click\\\", function () { api(\\\"config\\\", body()).then(function () { say(tr(\\\"saved\\\"), \\\"ok\\\"); state(); }).catch(function (e) { say(e.message, \\\"err\\\"); }); });\\n  $(\\\"tg\\\").addEventListener(\\\"click\\\", function () { api(\\\"test\\\", { kind: \\\"goal\\\" }).then(function () { say(tr(\\\"sent\\\"), \\\"ok\\\"); setTimeout(state, 600); }).catch(function (e) { say(e.message, \\\"err\\\"); }); });\\n  $(\\\"ta\\\").addEventListener(\\\"click\\\", function () { api(\\\"test\\\", { kind: \\\"against\\\" }).then(function () { say(tr(\\\"sent\\\"), \\\"ok\\\"); setTimeout(state, 600); }).catch(function (e) { say(e.message, \\\"err\\\"); }); });\\n  $(\\\"poll\\\").addEventListener(\\\"click\\\", function () { api(\\\"poll\\\", {}).then(function () { setTimeout(state, 1500); }); });\\n  $(\\\"goalsec\\\").addEventListener(\\\"input\\\", function () { $(\\\"goalsecv\\\").textContent = this.value + \\\" s\\\"; });\\n  $(\\\"othersec\\\").addEventListener(\\\"input\\\", function () { $(\\\"othersecv\\\").textContent = this.value + \\\" s\\\"; });\\n  function setLang(l) { lang = l; applyText(); fill(); api(\\\"config\\\", { lang: l }).catch(function () { /* keep UI language */ }); }\\n  $(\\\"l-en\\\").addEventListener(\\\"click\\\", function () { setLang(\\\"en\\\"); });\\n  $(\\\"l-pt\\\").addEventListener(\\\"click\\\", function () { setLang(\\\"pt\\\"); });\\n  applyText();\\n  state().then(function () { if (cfg && cfg.lang !== lang) { lang = cfg.lang; applyText(); fill(); } });\\n  setInterval(state, 15000);\\n})();\\n</script>\\n</body>\\n</html>\\n\"}}\n","ui.html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"dark light\">\n<title>Match alerts</title>\n<style>\n:root { --bg: #0b0e14; --card: #161b26; --line: #262e3f; --txt: #eef2f9; --dim: #8b96ab; --acc: #2f7bff; --ok: #2fc28b; --alert: #f0506e; }\n* { box-sizing: border-box; }\nbody { margin: 0; padding: 16px; font: 15px/1.45 \"Segoe UI\", system-ui, sans-serif; background: var(--bg); color: var(--txt); }\n.head { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }\n.logo { width: 42px; height: 42px; border-radius: 12px; background: linear-gradient(135deg, #2fc28b, #2f7bff); display: grid; place-items: center; font-size: 22px; }\nh1 { font-size: 20px; margin: 0; flex: 1; font-weight: 600; }\n.lang { display: flex; background: var(--card); border: 1px solid var(--line); border-radius: 20px; overflow: hidden; }\n.lang button { border: 0; background: none; color: var(--dim); padding: 6px 12px; cursor: pointer; font: inherit; }\n.lang button.on { background: var(--acc); color: #fff; }\n.grid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); }\n.card { background: var(--card); border: 1px solid var(--line); border-radius: 20px; padding: 16px; }\nh2 { font-size: 13px; letter-spacing: .06em; text-transform: uppercase; color: var(--dim); margin: 0 0 12px; font-weight: 600; }\nlabel.f { display: block; color: var(--dim); font-size: 13px; margin: 10px 0 4px; }\ninput, select, button { font: inherit; color: inherit; }\ninput[type=text], input[type=password], select { width: 100%; background: #0f131c; border: 1px solid var(--line); border-radius: 12px; padding: 10px 12px; }\ninput:focus, select:focus { outline: 2px solid var(--acc); border-color: transparent; }\n.row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }\n.row.sp { margin-top: 10px; }\n.chk { display: flex; align-items: center; gap: 8px; color: var(--txt); padding: 4px 0; }\n.dur { display: flex; align-items: center; gap: 12px; color: var(--dim); font-size: 13px; margin-top: 8px; }\n.dur input { flex: 1; accent-color: var(--acc); }\n.dur b { color: var(--txt); min-width: 44px; text-align: right; }\nbutton.p { background: var(--acc); border: 0; border-radius: 20px; padding: 8px 20px; cursor: pointer; font-weight: 600; color: #fff; }\nbutton.g { background: none; border: 1px solid var(--line); border-radius: 18px; padding: 6px 14px; cursor: pointer; color: var(--dim); }\n.msg { min-height: 20px; margin-top: 8px; font-size: 13px; color: var(--dim); } .ok { color: var(--ok); } .err { color: var(--alert); }\n.live { font-size: 18px; font-weight: 600; margin: 4px 0; }\nul { list-style: none; margin: 0; padding: 0; }\nli { padding: 8px 0; border-bottom: 1px solid var(--line); } li:last-child { border: 0; } li small { color: var(--dim); display: block; }\n.empty { color: var(--dim); text-align: center; padding: 14px 0; }\n[hidden] { display: none !important; }\nbutton { transition: transform .08s, background .2s, opacity .2s; }\nbutton:active { transform: scale(.94); }\nbutton.busy { opacity: .65; pointer-events: none; }\nbutton.busy::after { content: \"\"; display: inline-block; width: 10px; height: 10px; margin-left: 8px; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; animation: sp .7s linear infinite; vertical-align: -1px; }\nbutton.done { background: var(--ok) !important; border-color: var(--ok) !important; color: #fff !important; }\nbutton.fail { background: var(--alert) !important; border-color: var(--alert) !important; color: #fff !important; }\n@keyframes sp { to { transform: rotate(360deg); } }\n</style>\n</head>\n<body>\n<div class=\"head\">\n  <div class=\"logo\">&#9917;</div>\n  <h1 data-t=\"title\">Match alerts</h1>\n  <div class=\"lang\"><button type=\"button\" id=\"l-en\">EN</button><button type=\"button\" id=\"l-pt\">PT</button></div>\n</div>\n<div class=\"grid\">\n  <div class=\"card\">\n    <h2 data-t=\"source\">Score source</h2>\n    <label class=\"f\" data-t=\"provider\">Provider</label>\n    <select id=\"provider\"></select>\n    <div id=\"keybox\" hidden>\n      <label class=\"f\" data-t=\"apikey\">API key (stored on the TV only)</label>\n      <div class=\"row\"><input type=\"password\" id=\"apikey\" style=\"flex:1\" autocomplete=\"off\"><button type=\"button\" class=\"g\" id=\"savekey\" data-t=\"save\">Save</button></div>\n      <div class=\"msg\" id=\"keystate\"></div>\n    </div>\n    <label class=\"f\" data-t=\"team\">Team</label>\n    <select id=\"team\"></select>\n    <div class=\"msg\" id=\"teamnote\"></div>\n    <div class=\"msg\" id=\"result\"></div>\n  </div>\n  <div class=\"card\">\n    <h2 data-t=\"now\">Right now</h2>\n    <div class=\"live\" id=\"line\">-</div>\n    <div class=\"msg\" id=\"stat\"></div>\n    <div class=\"row sp\"><button type=\"button\" class=\"g\" id=\"poll\" data-t=\"check\">Check now</button></div>\n  </div>\n  <div class=\"card\">\n    <h2 data-t=\"alerts\">Alerts</h2>\n    <label class=\"chk\"><input type=\"checkbox\" data-on=\"goal\"> <span data-t=\"a_goal\">Goal for my team</span></label>\n    <label class=\"chk\"><input type=\"checkbox\" data-on=\"against\"> <span data-t=\"a_against\">Goal for the opponent</span></label>\n    <label class=\"chk\"><input type=\"checkbox\" data-on=\"start\"> <span data-t=\"a_start\">Kick-off</span></label>\n    <label class=\"chk\"><input type=\"checkbox\" data-on=\"half\"> <span data-t=\"a_half\">Half-time</span></label>\n    <label class=\"chk\"><input type=\"checkbox\" data-on=\"end\"> <span data-t=\"a_end\">Full time</span></label>\n    <div class=\"dur\"><span data-t=\"goalsec\">Goal banner (s)</span><input type=\"range\" id=\"goalsec\" min=\"5\" max=\"60\"><b id=\"goalsecv\"></b></div>\n    <div class=\"dur\"><span data-t=\"othersec\">Other banners (s)</span><input type=\"range\" id=\"othersec\" min=\"3\" max=\"30\"><b id=\"othersecv\"></b></div>\n    <div class=\"row sp\"><button type=\"button\" class=\"p\" id=\"save\" data-t=\"save\">Save</button><button type=\"button\" class=\"g\" id=\"tg\" data-t=\"testgoal\">Test: goal</button><button type=\"button\" class=\"g\" id=\"ta\" data-t=\"testag\">Test: goal against</button></div>\n  </div>\n  <div class=\"card\">\n    <h2 data-t=\"recent\">Recent alerts</h2>\n    <ul id=\"log\"></ul>\n  </div>\n</div>\n<script>\n(function () {\n  \"use strict\";\n  var $ = function (id) { return document.getElementById(id); };\n  var T = {\n    en: { title: \"Match alerts\", source: \"Score source\", provider: \"Provider\", apikey: \"API key (stored on the TV only)\", save: \"Save\", team: \"Team\", now: \"Right now\", check: \"Check now\",\n      alerts: \"Alerts\", a_goal: \"Goal for my team\", a_against: \"Goal for the opponent\", a_start: \"Kick-off\", a_half: \"Half-time\", a_end: \"Full time\",\n      goalsec: \"Goal banner (s)\", othersec: \"Other banners (s)\", testgoal: \"Test: goal\", testag: \"Test: goal against\", recent: \"Recent alerts\",\n      nomatch: \"No match for this team right now.\", saved: \"Saved.\", keyset: \"A key is saved.\", keynone: \"No key saved yet.\", noneyet: \"Nothing yet.\", checked: \"Last check: \", err: \"Error: \", sent: \"Test sent.\", checking: \"Checking...\", loadteams: \"Could not load the team list: \" },\n    pt: { title: \"Alertas de jogo\", source: \"Fonte de resultados\", provider: \"Fornecedor\", apikey: \"Chave da API (guardada s\\u00F3 na TV)\", save: \"Guardar\", team: \"Equipa\", now: \"Agora\", check: \"Verificar agora\",\n      alerts: \"Alertas\", a_goal: \"Golo da minha equipa\", a_against: \"Golo do advers\\u00E1rio\", a_start: \"In\\u00EDcio do jogo\", a_half: \"Intervalo\", a_end: \"Fim do jogo\",\n      goalsec: \"Banner de golo (s)\", othersec: \"Outros banners (s)\", testgoal: \"Teste: golo\", testag: \"Teste: golo sofrido\", recent: \"Alertas recentes\",\n      nomatch: \"Sem jogo desta equipa neste momento.\", saved: \"Guardado.\", keyset: \"H\\u00E1 uma chave guardada.\", keynone: \"Ainda sem chave.\", noneyet: \"Ainda nada.\", checked: \"\\u00DAltima verifica\\u00E7\\u00E3o: \", err: \"Erro: \", sent: \"Teste enviado.\", checking: \"A verificar...\", loadteams: \"N\\u00E3o foi poss\\u00EDvel carregar as equipas: \" }\n  };\n  var lang = \"en\", cfg = null;\n  function tr(k) { return T[lang][k] || T.en[k] || k; }\n  function esc(s) { return String(s == null ? \"\" : s).replace(/[&<>\"']/g, function (c) { return { \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" }[c]; }); }\n  function say(t, cls) { $(\"result\").textContent = t || \"\"; $(\"result\").className = \"msg \" + (cls || \"\"); }\n  function api(path, body) {\n    var opt = body ? { method: \"POST\", headers: { \"Content-Type\": \"application/json\" }, body: JSON.stringify(body) } : {};\n    return fetch(path, opt).then(function (r) { return r.json().then(function (j) { if (!r.ok) { throw new Error(j.error || \"error \" + r.status); } return j; }); });\n  }\n  // Visible feedback on every action button: spinner while it runs (at least 0.45 s), then green (done) or red (failed) for a moment.\n  function act(btn, p) {\n    var t0 = Date.now();\n    btn.classList.add(\"busy\");\n    function end(cls) {\n      setTimeout(function () {\n        btn.classList.remove(\"busy\"); btn.classList.add(cls);\n        setTimeout(function () { btn.classList.remove(cls); }, 1300);\n      }, Math.max(0, 450 - (Date.now() - t0)));\n    }\n    p.then(function () { end(\"done\"); }, function (e) { say(e.message, \"err\"); end(\"fail\"); });\n  }\n  function applyText() {\n    document.documentElement.lang = lang;\n    var els = document.querySelectorAll(\"[data-t]\"), i;\n    for (i = 0; i < els.length; i++) { els[i].textContent = tr(els[i].getAttribute(\"data-t\")); }\n    $(\"l-en\").className = lang === \"en\" ? \"on\" : \"\"; $(\"l-pt\").className = lang === \"pt\" ? \"on\" : \"\";\n  }\n  function fill() {\n    if (!cfg) { return; }\n    var i, p = $(\"provider\"), prov;\n    p.innerHTML = cfg.providers.map(function (x) { return '<option value=\"' + esc(x.id) + '\">' + esc(x.label) + \"</option>\"; }).join(\"\");\n    p.value = cfg.provider;\n    for (i = 0; i < cfg.providers.length; i++) { if (cfg.providers[i].id === cfg.provider) { prov = cfg.providers[i]; } }\n    $(\"keybox\").hidden = !(prov && prov.needsKey);\n    $(\"keystate\").textContent = cfg.hasKey ? tr(\"keyset\") : tr(\"keynone\");\n    var boxes = document.querySelectorAll(\"[data-on]\");\n    for (i = 0; i < boxes.length; i++) { boxes[i].checked = !!cfg.on[boxes[i].getAttribute(\"data-on\")]; }\n    $(\"goalsec\").value = cfg.goalSeconds; $(\"goalsecv\").textContent = cfg.goalSeconds + \" s\";\n    $(\"othersec\").value = cfg.otherSeconds; $(\"othersecv\").textContent = cfg.otherSeconds + \" s\";\n  }\n  function teams() {\n    api(\"teams\").then(function (d) {\n      var sel = $(\"team\"), found = false;\n      sel.innerHTML = d.teams.map(function (t) { if (t.id === cfg.teamId) { found = true; } return '<option value=\"' + esc(t.id) + '\">' + esc(t.name) + \"</option>\"; }).join(\"\");\n      if (!found) { sel.insertAdjacentHTML(\"afterbegin\", '<option value=\"' + esc(cfg.teamId) + '\">' + esc(cfg.teamName) + \"</option>\"); }\n      sel.value = cfg.teamId; $(\"teamnote\").textContent = \"\";\n    }).catch(function (e) { $(\"team\").innerHTML = '<option value=\"' + esc(cfg.teamId) + '\">' + esc(cfg.teamName) + \"</option>\"; $(\"teamnote\").textContent = tr(\"loadteams\") + e.message; });\n  }\n  function state() {\n    return api(\"state\").then(function (d) {\n      var first = !cfg || cfg.provider !== d.config.provider; cfg = d.config;\n      fill(); if (first) { teams(); }\n      $(\"line\").textContent = d.status.line || tr(\"nomatch\");\n      $(\"stat\").textContent = (d.status.state ? d.status.state + \" \\u00B7 \" : \"\") + (d.status.at ? tr(\"checked\") + new Date(d.status.at).toLocaleTimeString() : \"\") + (d.status.error ? \" \\u00B7 \" + tr(\"err\") + d.status.error : \"\");\n      $(\"log\").innerHTML = d.log.length ? d.log.map(function (e) { return \"<li>\" + esc(e.text) + \"<small>\" + new Date(e.at).toLocaleTimeString() + \"</small></li>\"; }).join(\"\") : '<li class=\"empty\">' + esc(tr(\"noneyet\")) + \"</li>\";\n    }).catch(function (e) { say(tr(\"err\") + e.message, \"err\"); });\n  }\n  function body() {\n    var on = {}, boxes = document.querySelectorAll(\"[data-on]\"), i;\n    for (i = 0; i < boxes.length; i++) { on[boxes[i].getAttribute(\"data-on\")] = boxes[i].checked; }\n    var sel = $(\"team\"), opt = sel.options[sel.selectedIndex];\n    return { teamId: sel.value, teamName: opt ? opt.text : \"\", on: on, goalSeconds: parseInt($(\"goalsec\").value, 10), otherSeconds: parseInt($(\"othersec\").value, 10), lang: lang };\n  }\n  // The dashboard frame has no allow-forms: buttons only.\n  $(\"provider\").addEventListener(\"change\", function () { cfg = null; api(\"config\", { provider: this.value }).then(function () { state(); }).catch(function (e) { say(e.message, \"err\"); }); });\n  $(\"savekey\").addEventListener(\"click\", function () { act(this, api(\"config\", { apiKey: $(\"apikey\").value }).then(function () { $(\"apikey\").value = \"\"; say(tr(\"saved\"), \"ok\"); state(); })); });\n  $(\"save\").addEventListener(\"click\", function () { act(this, api(\"config\", body()).then(function () { say(tr(\"saved\"), \"ok\"); state(); })); });\n  $(\"tg\").addEventListener(\"click\", function () { act(this, api(\"test\", { kind: \"goal\" }).then(function () { say(tr(\"sent\"), \"ok\"); setTimeout(state, 600); })); });\n  $(\"ta\").addEventListener(\"click\", function () { act(this, api(\"test\", { kind: \"against\" }).then(function () { say(tr(\"sent\"), \"ok\"); setTimeout(state, 600); })); });\n  $(\"poll\").addEventListener(\"click\", function () { act(this, api(\"poll\", {}).then(function () { say(tr(\"checking\"), \"ok\"); return new Promise(function (r) { setTimeout(r, 1500); }).then(state); })); });\n  $(\"goalsec\").addEventListener(\"input\", function () { $(\"goalsecv\").textContent = this.value + \" s\"; });\n  $(\"othersec\").addEventListener(\"input\", function () { $(\"othersecv\").textContent = this.value + \" s\"; });\n  function setLang(l) { lang = l; applyText(); fill(); api(\"config\", { lang: l }).catch(function () { /* keep UI language */ }); }\n  $(\"l-en\").addEventListener(\"click\", function () { setLang(\"en\"); });\n  $(\"l-pt\").addEventListener(\"click\", function () { setLang(\"pt\"); });\n  applyText();\n  state().then(function () { if (cfg && cfg.lang !== lang) { lang = cfg.lang; applyText(); fill(); } });\n  setInterval(state, 15000);\n})();\n</script>\n</body>\n</html>\n"}}
